# Frontend environment variables (used by Vite at build time)
# Vercel should set these under Project Settings → Environment Variables.

# Example backend base URL (if/when you add a backend):
# REACT_APP_API_URL=https://your-backend.com/api

# For frontend-only deployment, you can leave this unset.
# Default in code is: http://localhost:5000/api
REACT_APP_API_URL=
